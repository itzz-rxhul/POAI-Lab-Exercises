# Continuous Environment Agent
# Environment has infinite/smooth possible values (like real-world position or speed)
 
class ContinuousEnvAgent:
    def act(self, position):
        next_pos = position + 0.5  # can move by any fractional amount
        print(f"Continuous move: moving from position {position} to {next_pos}")
        return next_pos
 
 
# Demo
agent = ContinuousEnvAgent()
pos = 0.0
while pos < 2.0:
    pos = agent.act(pos)
 
print("Reached target range!")
