class EpisodicAgent:
    def act(self, image):
        # each image is a fresh, unrelated episode
        print(f"New episode. Classifying image: {image} (no memory of past images)")
        return "cat" if "cat" in image else "not cat"
 
 
# Demo
agent = EpisodicAgent()
agent.act("cat_photo.jpg")
agent.act("dog_photo.jpg")
agent.act("cat_photo2.jpg")

class KnownEnvAgent:
    def __init__(self):
        self.map = {"A": "B", "B": "C", "C": "Goal"}
 
    def act(self, position):
        print(f"I know the map. Moving from {position} to {self.map[position]}")
        return self.map[position]
 
 
# Demo
agent = KnownEnvAgent()
pos = "A"
while pos != "Goal":
    pos = agent.act(pos)
 
print("Reached the goal!")

class UnknownEnvAgent:
    def act(self, position, sensed_options):
        print(f"I don't know the map. At {position}, I sense: {sensed_options}")
        choice = sensed_options[0]
        print(f"Exploring towards: {choice}")
        return choice
 
 
# Demo
agent = UnknownEnvAgent()
agent.act("A", ["B", "D"])
 
 
