import random

class DroneAgent:

    def __init__(self):
        self.locations = {
            "Warehouse": "Unknown",
            "Customer": "Unknown"
        }

    def observe(self):
        place = random.choice(list(self.locations.keys()))
        status = random.choice(["Clear", "Blocked"])
        self.locations[place] = status
        print("Observed:", place, "=", status)

    def decide(self):
        if self.locations["Customer"] == "Clear":
            print("Deliver Package")
        else:
            print("Wait for better visibility")

agent = DroneAgent()

for i in range(3):
    agent.observe()

agent.decide()
class SequentialAgent:
    def __init__(self):
        self.history = []  # remembers past moves
 
    def act(self, move):
        self.history.append(move)
        print(f"Move: {move} | Full history so far: {self.history}")
 
 
# Demo (like a chess game - each move depends on previous ones)
agent = SequentialAgent()
agent.act("e4")
agent.act("e5")
agent.act("Nf3")

