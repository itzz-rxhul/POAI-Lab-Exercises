# Environment has a limited, countable set of states (like steps on a grid)
 
class DiscreteEnvAgent:
    def __init__(self):
        self.states = [1, 2, 3, 4, 5]  # fixed, countable positions
 
    def act(self, position):
        next_pos = position + 1
        print(f"Discrete step: moving from state {position} to state {next_pos}")
        return next_pos
 
 
