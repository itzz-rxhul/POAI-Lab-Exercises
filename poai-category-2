class VacuumAgent:
    def __init__(self):
        self.environment = {
            "A": "Dirty",
            "B": "Clean"
        }

    def display(self):
        print("Current Environment:")
        for room, state in self.environment.items():
            print(room, ":", state)

    def clean(self):
        for room in self.environment:
            if self.environment[room] == "Dirty":
                print("Cleaning Room", room)
                self.environment[room] = "Clean"
            else:
                print("Room", room, "is already clean")

