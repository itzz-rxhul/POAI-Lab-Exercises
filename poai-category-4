def dfs(graph, node, goal, visited=None, path=None):
    if visited is None:
        visited = set()

    if path is None:
        path = []

    visited.add(node)
    path.append(node)

    if node == goal:
        return path

    for neighbor in graph[node]:
        if neighbor not in visited:
            result = dfs(graph, neighbor, goal, visited, path)

            if result:
                return result

    path.pop()
    return None


