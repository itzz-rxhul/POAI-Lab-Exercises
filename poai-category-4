def depth_limited_search(graph, node, goal, limit, path=None):
    if path is None:
        path = []

    path.append(node)

    if node == goal:
        return path

    if limit == 0:
        path.pop()
        return None

    for neighbor in graph[node]:
        result = depth_limited_search(
            graph,
            neighbor,
            goal,
            limit - 1,
            path
        )

        if result:
            return result

    path.pop()
    return None


