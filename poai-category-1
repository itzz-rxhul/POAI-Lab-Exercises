# Utility-Based Agent - Restaurant Selection
# ----------------------------------------

restaurants = {
    "Restaurant A": 70,
    "Restaurant B": 95,
    "Restaurant C": 82,
    "Restaurant D": 88
}

print("=== Restaurant Recommendation ===")

print("\nAvailable Restaurants\n")

for name, utility in restaurants.items():
    print(name, "-> Utility Score:", utility)

best = max(restaurants, key=restaurants.get)

print("\nBest Restaurant:", best)
print("Utility Score:", restaurants[best])
