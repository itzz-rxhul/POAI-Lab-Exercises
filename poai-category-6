#2.Alpha-Beta Pruning Algorithm for Chess:

def evaluate(board):
    values = {
        'P': 1,
        'N': 3,
        'B': 3,
        'R': 5,
        'Q': 9,
        'K': 100
    }

    score = 0

    for row in board:
        for piece in row:
            if piece in values:
                score += values[piece]
            elif piece.lower() in values:
                score -= values[piece.lower()]
            return score

def generate_moves(board, player):
    moves = []

    for i in range(2):
        for j in range(2):
            if board[i][j] == '.':
                new_board = [row[:] for row in board]
                new_board[i][j] = player
                moves.append(new_board)

    return moves
def alpha_beta(board, depth, alpha, beta, maximizing_player):

    if depth == 0:
        return evaluate(board)

    player = 'P' if maximizing_player else 'p'
    moves = generate_moves(board, player)

    if not moves:
        return evaluate(board)

    if maximizing_player:

        best = float('-inf')

        for move in moves:

            value = alpha_beta(
                move,
                depth - 1,
                alpha,
                beta,
                False
            )

            best = max(best, value)

            alpha = max(alpha, best)

            # Beta cutoff
            if beta <= alpha:
                break

        return best

    else:

        best = float('inf')

        for move in moves:

            value = alpha_beta(
                move,
                depth - 1,
                alpha,
                beta,
                True
            )

            best = min(best, value)

            beta = min(beta, best)

            # Alpha cutoff
            if beta <= alpha:
                break
        return best


