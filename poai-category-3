import random
import math

# --------------------------------------------------
# STATE SEARCH SPACE
# --------------------------------------------------

states = {
    "A": {"value": 2, "neighbors": ["B", "C"]},
    "B": {"value": 5, "neighbors": ["A", "D"]},
    "C": {"value": 4, "neighbors": ["A", "E"]},
    "D": {"value": 7, "neighbors": ["B", "F"]},
    "E": {"value": 6, "neighbors": ["C", "G"]},
    "F": {"value": 8, "neighbors": ["D"]},
    "G": {"value": 10, "neighbors": ["E"]}
}


# --------------------------------------------------
# 1. HILL CLIMBING
# High Exploitation, Low Exploration
# --------------------------------------------------

def hill_climbing(start):

    current = start
    path = [current]

    while True:

        neighbors = states[current]["neighbors"]

        if not neighbors:
            break

        best_neighbor = max(
            neighbors,
            key=lambda x: states[x]["value"]
        )

        if states[best_neighbor]["value"] <= states[current]["value"]:
            break

        current = best_neighbor
        path.append(current)

    return current, path


# --------------------------------------------------
# 2. SIMULATED ANNEALING
# Exploration initially, Exploitation later
# --------------------------------------------------

def simulated_annealing(start):

    current = start
    best = start
    temperature = 100

    path = [current]

    while temperature > 0.1:

        neighbors = states[current]["neighbors"]

        if not neighbors:
            break

        next_state = random.choice(neighbors)

        current_value = states[current]["value"]
        next_value = states[next_state]["value"]

        difference = next_value - current_value

        # Better state → always accept
        if difference > 0:

            current = next_state

        # Worse state → sometimes accept
        else:

            probability = math.exp(difference / temperature)

            if random.random() < probability:
                current = next_state

        path.append(current)

        # Update best solution
        if states[current]["value"] > states[best]["value"]:
            best = current

        # Cooling
        temperature *= 0.95

    return best, path


# --------------------------------------------------
# 3. LOCAL BEAM SEARCH
# Maintains multiple states
# --------------------------------------------------

def local_beam_search(initial_states, k=2):

    current_states = initial_states
    path = []

    while True:

        path.extend(current_states)

        successors = []

        for state in current_states:
            successors.extend(states[state]["neighbors"])

        if not successors:
            break

        # Remove duplicate states
        successors = list(set(successors))

        # Select best K states
        successors.sort(
            key=lambda x: states[x]["value"],
            reverse=True
        )

        next_states = successors[:k]

        # If no improvement, stop
        current_best = max(
            states[s]["value"]
            for s in current_states
        )

        next_best = max(
            states[s]["value"]
            for s in next_states
        )

        if next_best <= current_best:
            break

        current_states = next_states

    best = max(
        current_states,
        key=lambda x: states[x]["value"]
    )

    return best, path


