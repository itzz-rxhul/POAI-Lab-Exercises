def manhattan(state, goal):

    distance = 0

    for i in range(9):

        if state[i] != 0:

            row, col = divmod(i, 3)

            goal_index = goal.index(state[i])
            goal_row, goal_col = divmod(goal_index, 3)

            distance += abs(row - goal_row)
            distance += abs(col - goal_col)

    return distance
def get_neighbors(state):

    neighbors = []

    zero = state.index(0)

    row, col = divmod(zero, 3)

    moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]

    for dr, dc in moves:

        new_row = row + dr
        new_col = col + dc

        if 0 <= new_row < 3 and 0 <= new_col < 3:

            new_zero = new_row * 3 + new_col

            new_state = list(state)

            new_state[zero], new_state[new_zero] = \
                new_state[new_zero], new_state[zero]

            neighbors.append(tuple(new_state))

    return neighbors
def search(path, goal, g, threshold):

    current = path[-1]

    f = g + manhattan(current, goal)

    if f > threshold:
        return f

    if current == goal:
        return "FOUND"

    minimum = float('inf')

    for neighbor in get_neighbors(current):

        if neighbor not in path:

            path.append(neighbor)

            result = search(
                path,
                goal,
                g + 1,
                threshold
            )

            if result == "FOUND":
                return "FOUND"

            if result < minimum:
                minimum = result

            path.pop()

    return minimum
def ida_star(start, goal):

    threshold = manhattan(start, goal)

    path = [start]

    while True:

        print("Current threshold:", threshold)

        result = search(
            path,
            goal,
            0,
            threshold
        )

        if result == "FOUND":

            print("\nGoal reached!")

            print("\nSolution Path:")

            for state in path:
                print(state)

            return

        if result == float('inf'):

            print("No solution found.")
            return

        threshold = result
